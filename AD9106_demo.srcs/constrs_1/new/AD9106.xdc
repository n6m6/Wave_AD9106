set_property IOSTANDARD LVCMOS33 [get_ports ad9106_cs_n_0]
set_property PACKAGE_PIN C13 [get_ports ad9106_reset_0]
set_property IOSTANDARD LVCMOS33 [get_ports ad9106_reset_0]
